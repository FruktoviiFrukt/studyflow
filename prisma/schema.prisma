generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Auth & Users
// ---------------------------------------------------------------------------

enum Role {
  STUDENT
  ADMIN
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  password     String
  name         String
  role         Role     @default(STUDENT)
  group        String?
  groupId      String?
  subgroupId   String?
  geminiApiKey String? // AES-256-GCM encrypted, never stored plain
  createdAt    DateTime @default(now())

  // Relations: Schedule module
  studyGroup StudyGroup? @relation(fields: [groupId], references: [id], onDelete: Restrict)
  subgroup   Subgroup?   @relation(fields: [subgroupId, groupId], references: [id, groupId], onDelete: Restrict)

  // Relations: AI Coach module
  enrolledSubjects UserSubject[]
  documents        Document[]
  quizSessions     QuizSession[]
  tasks            Task[]

  gpaProfile GpaProfile?

  @@index([groupId])
  @@index([subgroupId, groupId])
}

// ---------------------------------------------------------------------------
// Tasks Module
// ---------------------------------------------------------------------------

model Task {
  id        String   @id @default(cuid())
  userId    String
  title     String
  subject   String
  type      String
  priority  String
  status    String
  dueDate   String
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Schedule Module Enums & Models
// ---------------------------------------------------------------------------

enum WeekPattern {
  EVERY
  ODD
  EVEN
}

enum ScheduleStatus {
  DRAFT
  PUBLISHED
}

enum ScheduleKind {
  STUDENT
  GLOBAL
  ASSESSMENT
}

enum LessonType {
  LECTURE
  LABORATORY
  PRACTICE
  SEMINAR
  UNSPECIFIED
}

model AcademicYear {
  id                 String     @id @default(cuid())
  name               String     @unique
  startsOn           DateTime   @db.Date
  endsOn             DateTime   @db.Date
  // Monday starting the first odd week. Holidays do not reset the count.
  firstOddWeekMonday DateTime   @db.Date
  semesters          Semester[]
}

model Semester {
  id             String           @id @default(cuid())
  academicYearId String
  number         Int
  startsOn       DateTime         @db.Date
  endsOn         DateTime         @db.Date
  academicYear   AcademicYear     @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  schedules      ScheduleImport[]

  @@unique([academicYearId, number])
}

model StudyGroup {
  id        String           @id @default(cuid())
  name      String           @unique
  subgroups Subgroup[]
  students  User[]
  audiences LessonAudience[]
}

model Subgroup {
  id        String           @id @default(cuid())
  groupId   String
  number    Int
  group     StudyGroup       @relation(fields: [groupId], references: [id], onDelete: Restrict)
  students  User[]
  audiences LessonAudience[]

  @@unique([groupId, number])
  @@unique([id, groupId])
}

model Subject {
  id       String   @id @default(cuid())
  name     String   @unique
  // Palette key; CSS classes belong to the frontend.
  colorKey String   @default("blue")
  lessons  Lesson[]
}

model ScheduleImport {
  id             String            @id @default(cuid())
  semesterId     String
  course         Int
  kind           ScheduleKind      @default(STUDENT)
  title          String
  sourceFilename String?
  sourceFileKey  String?
  importWarnings String[]          @default([])
  status         ScheduleStatus    @default(DRAFT)
  validFrom      DateTime          @db.Date
  validTo        DateTime          @db.Date
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  semester       Semester          @relation(fields: [semesterId], references: [id], onDelete: Restrict)
  lessons        Lesson[]
  holidays       ScheduleHoliday[]

  @@index([semesterId, course, status])
  @@index([status, validFrom, validTo])
  @@index([kind, status, validFrom, validTo])
}

model Lesson {
  id           String           @id @default(cuid())
  scheduleId   String
  subjectId    String
  // Monday = 0, Sunday = 6.
  weekday      Int
  startMinutes Int
  endMinutes   Int
  weekPattern  WeekPattern      @default(EVERY)
  type         LessonType       @default(UNSPECIFIED)
  teacher      String?
  classroom    String?
  topic        String?
  sourceText   String?
  reviewed     Boolean          @default(false)
  schedule     ScheduleImport   @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  subject      Subject          @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  audiences    LessonAudience[]

  @@index([scheduleId, weekday, startMinutes])
  @@index([subjectId])
}

model LessonAudience {
  id         String     @id @default(cuid())
  lessonId   String
  groupId    String
  // Null means the entire group, not an unknown subgroup.
  subgroupId String?
  lesson     Lesson     @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  group      StudyGroup @relation(fields: [groupId], references: [id], onDelete: Restrict)
  subgroup   Subgroup?  @relation(fields: [subgroupId, groupId], references: [id, groupId], onDelete: Restrict)

  @@unique([lessonId, groupId, subgroupId])
  @@index([groupId, lessonId])
  @@index([subgroupId, groupId])
}

model ScheduleHoliday {
  id         String         @id @default(cuid())
  scheduleId String
  name       String
  startsOn   DateTime       @db.Date
  endsOn     DateTime       @db.Date
  schedule   ScheduleImport @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@index([scheduleId, startsOn, endsOn])
}

// ---------------------------------------------------------------------------
// AI Coach Module: Faculty subject registry & Knowledge base
// ---------------------------------------------------------------------------

model FacultySubject {
  id        String   @id @default(cuid())
  name      String   @unique
  code      String   @unique
  faculty   String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  topics      Topic[]
  enrollments UserSubject[]
  documents   Document[]
}

model UserSubject {
  userId    String
  subjectId String

  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject FacultySubject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@id([userId, subjectId])
}

model Topic {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())

  subjects  FacultySubject[]
  questions Question[]
  documents Document[]
}

enum QuestionType {
  MULTIPLE_CHOICE
  TRUE_FALSE
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

model Question {
  id         String       @id @default(cuid())
  text       String
  textHash   String       @unique
  type       QuestionType
  difficulty Difficulty
  topicId    String
  approvedAt DateTime?
  createdAt  DateTime     @default(now())

  topic       Topic                 @relation(fields: [topicId], references: [id])
  options     Option[]
  sessionRefs QuizSessionQuestion[]
  answers     QuizAnswer[]
}

model Option {
  id         String  @id @default(cuid())
  text       String
  isCorrect  Boolean
  questionId String

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

enum DocumentStatus {
  PENDING
  PROCESSING
  DONE
  REJECTED
}

model Document {
  id           String         @id @default(cuid())
  userId       String
  fileName     String?
  textContent  String?
  subjectId    String?
  topicId      String?
  status       DocumentStatus @default(PENDING)
  errorMessage String?
  createdAt    DateTime       @default(now())

  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject FacultySubject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  topic   Topic?          @relation(fields: [topicId], references: [id], onDelete: SetNull)
}

model QuizSession {
  id          String    @id @default(cuid())
  userId      String
  score       Int?
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  user      User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  questions QuizSessionQuestion[]
  answers   QuizAnswer[]
}

model QuizSessionQuestion {
  sessionId  String
  questionId String
  order      Int

  session  QuizSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  question Question    @relation(fields: [questionId], references: [id])

  @@id([sessionId, questionId])
}

model QuizAnswer {
  id               String   @id @default(cuid())
  sessionId        String
  questionId       String
  selectedOptionId String
  isCorrect        Boolean
  createdAt        DateTime @default(now())

  session  QuizSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  question Question    @relation(fields: [questionId], references: [id])

  @@unique([sessionId, questionId])
}

// ---------------------------------------------------------------------------
// GPA calculator
// ---------------------------------------------------------------------------

model GpaProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subjects  Json
  updatedAt DateTime @updatedAt
}

model Material {
  id           String   @id @default(cuid())
  title        String
  subject      String
  type         String
  size         Int
  originalName String
  storageKey   String   @unique
  mimeType     String
  contentHash  String   @unique
  uploadedAt   DateTime @default(now())

  @@index([uploadedAt])
}
