# Copy this file to .env and adjust values if needed.
# Matches the credentials defined in docker-compose.yml.
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/studyflow?schema=public"

# Ask a teammate for the real value — do not put it here.
AUTH_SECRET=

# Optional: override the Gemini model (default: gemini-3.5-flash-lite)
# GEMINI_MODEL=gemini-3.5-flash-lite
